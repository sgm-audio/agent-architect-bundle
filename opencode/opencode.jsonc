      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "temperature": 0.2,
      "prompt": "{file:~/.config/opencode/agents/skillful/skillful/tom-builder.md}"
    }
  },
  "permission": {
    "skill": { "*": "allow" },
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow"
  },
  "command": {
    "recall": {
      "template": "Recall from memory:\n1. Call `memory_smart_search` (BM25 + vector + graph hybrid) and `memory_lesson_recall` with the user's query\n2. Combine results, group by session\n3. Show type, title, narrative for each result\n4. Highlight high-importance items (score >= 7)\n5. Show lessons with confidence scores",
      "description": "Search agentmemory for session history and lessons"
    },
    "remember": {
      "template": "Save to memory:\n1. Extract the core insight or information from context\n2. Derive 2-5 searchable concepts\n3. Extract relevant file paths\n4. Call `memory_save` with type (pattern|preference|architecture|bug|workflow|fact) and concepts\n5. Confirm what was saved",
      "description": "Save information to agentmemory for future recall"
    },
    "briefing": {
      "template": "Update the global session briefing:\n1. Call `agentmemory_memory_recall` with query \"global status briefing\" to get the current briefing if it exists\n2. Summarize what has been done recently (check recent memories and observations)\n3. Save an updated briefing via `memory_save` with:\n   - content: concise markdown with ## Done, ## Todo, ## Active sections\n   - type: fact\n   - concepts: global,briefing,status,todo,project\n4. Display the updated briefing to the user",
      "description": "Create or update the global session briefing (shown every chat)"
    },
    "changelog": {
      "template": "Retrieve and display the session changelog:\n1. Call `agentmemory_memory_recall` with query \"session-log\" to get recent session log entries\n2. Call `agentmemory_memory_recall` with query \"session-summary\" to get any compiled summaries\n3. Format as a markdown log showing each session with date, files changed, decisions, outcomes\n4. Display to user",
      "description": "Show the full session changelog from agentmemory"
    },
    "endsession": {
      "template": "Finalize the current session:\n1. Call `agentmemory_memory_recall` with query \"session-log session-{today's date YYYY-MM-DD}\" to get all entries from this session\n2. Compile into a final summary markdown with sections: ## Session {date}, ### Files Changed, ### Decisions, ### Outcomes\n3. Save the summary via `memory_save` with type=\"fact\", concepts=\"session-summary,session-{date}\"\n4. Append the summary to `~/.config/opencode/SESSION_LOG.md` using the Write tool\n5. Also update the global briefing: call `memory_recall` with query \"global status briefing\", incorporate this session's work, re-save\n6. Print the final session summary to the user",
      "description": "Finalize session: compile changelog, save summary, update briefing"
    },
    "build": {
      "template": "Run the full CMake build pipeline DAG for the project at {{project_dir}}:\n1. Run `run_cmake_pipeline` from the cmake-pipeline MCP\n2. Collect the result log\n3. If errors, report them. If ok, confirm the package path.\n\nDefault config: Release, arch: x64.",
      "description": "LangGraph DAG: cmake configure -> compile -> validate -> test -> sign -> package"
    },
    "reapack-prep": {
      "template": "Run the ReaPack prep pipeline on the current script:\n1. @lua-auditor -- read-only audit first\n2. @header-doctor -- repair/add ReaPack @metadata header\n3. @rt-optimizer -- fix paths, undo hygiene, performance\n4. @index-builder -- generate/validate ReaPack index\n\nPause after each step for human review before continuing.",
      "description": "Run ReaPack shipping pipeline (audit, header, optimize, index)"
    }
  }
}