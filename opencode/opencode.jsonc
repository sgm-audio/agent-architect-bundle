{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/deepseek-ai/deepseek-v4-flash",
  "provider": {
    "nvidia": {
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "deepseek-ai/deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek-ai/deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "moonshotai/kimi-k2.6": { "name": "Kimi K2.6 1T MoE (multimodal)" },
        "meta/llama-3.2-90b-vision-instruct": { "name": "Llama 3.2 90B Vision" },
        "meta/llama-3.2-11b-vision-instruct": { "name": "Llama 3.2 11B Vision" },
        "microsoft/phi-4-multimodal-instruct": { "name": "Phi-4 Multimodal Instruct" },
        "nvidia/nemotron-3-super-120b-a12b": { "name": "Nemotron 3 Super 120B (reasoning)" },
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra 550B (Frontier+)" },
        "nvidia/nemotron-4-340b-instruct": { "name": "Nemotron 4 340B Instruct" },
        "nvidia/nemotron-nano-12b-v2-vl": { "name": "Nemotron Nano 12B VL (vision)" },
        "nvidia/vila": { "name": "VILA (vision-language)" },
        "nvidia/llama-3.1-nemotron-nano-vl-8b-v1": { "name": "Nemotron Nano VL 8B (vision)" },
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning": { "name": "Nemotron Omni 30B (vision+reasoning)" },
        "nvidia/nvclip": { "name": "NVCLIP (vision embedding)" },
        "google/deplot": { "name": "DePlot (chart-to-text)" },
        "microsoft/kosmos-2": { "name": "Kosmos-2 (multimodal)" },
        "mistralai/mistral-nemotron": { "name": "Mistral Nemotron" },
        "minimaxai/minimax-m2.7": { "name": "Minimax M2.7" },
        "z-ai/glm-5.1": { "name": "GLM-5.1" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "gemma-3-4b-it-q4": { "name": "Gemma 3 4B (local)" },
        "qwen2.5:7b": { "name": "Qwen 2.5 7B (local)" },
        "dolphin-llama3:8b": { "name": "Dolphin Llama3 8B (local)" },
        "huihui_ai/gemma-4-abliterated:e4b-q4_K": { "name": "Gemma 4 Abliterated 4B (local)" },
        "minicpm-v:8b": { "name": "MiniCPM-V 8B (local)" },
        "lfm-2.5-1.2b-it-q8": { "name": "LFM 2.5 1.2B (local)" },
        "nomic-embed-text": { "name": "Nomic Embed Text (local)" }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/.config/opencode/meta-orchestrator.md"
  ],
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true
    },
    "superpowers": {
      "type": "local",
      "command": ["node", "/path/to/superpowers-mcp/build/index.js"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github@latest"],
      "enabled": true,
      "env": {
        "GITHUB_TOKEN": "{env:OC_GITHUB_PAT}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "puppeteer": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": true,
      "timeout": 30000
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "plugin": [
    "~/.config/opencode/plugins/agentmemory-capture.ts"
  ],
  "lsp": {
    "clangd": {
      "command": ["clangd"],
      "extensions": [".cpp", ".cc", ".cxx", ".c++", ".c", ".h", ".hpp", ".hh", ".hxx", ".h++"]
    },
    "cmake": {
      "command": ["cmake-language-server"],
      "extensions": [".cmake", "CMakeLists.txt"]
    },
    "json": {
      "command": ["vscode-json-languageserver", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "agent": {
    "code-squad": {
      "mode": "primary",
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "temperature": 0.3,
      "prompt": "{file:~/.config/opencode/agents/code-squad.md}"
    },
    "analytics-squad": {
      "mode": "primary",
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "temperature": 0.3,
      "prompt": "{file:~/.config/opencode/agents/analytics-squad.md}"
    },
    "vision-squad": {
      "mode": "primary",
      "model": "nvidia/moonshotai/kimi-k2.6",
      "temperature": 0.2,
      "prompt": "{file:~/.config/opencode/agents/vision-squad.md}"
    },
    "plan": {
      "mode": "primary",
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "temperature": 0.3,
      "prompt": "{file:~/.config/opencode/agents/plan.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow"
      }
    },
    "heavy-hitter": {
      "mode": "subagent",
      "hidden": true,
      "description": "Nvidia NIM frontier model squad for the hardest problems. Uses Nemotron 3 Ultra (frontier reasoning), DeepSeek V4 Pro (heavy engineering), and Kimi K2.6 (multimodal synthesis). Invoke when standard models aren't cutting it.",
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
      "temperature": 0.1,
      "prompt": "{file:~/.config/opencode/agents/heavy-hitter.md}"
    },
    "outreach-squad": {
      "mode": "subagent",
      "hidden": true,
      "description": "Lead generation, email finding, and cold outreach campaigns. Invoke when the task involves finding local business contacts or sending outreach emails.",
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "temperature": 0.3,
      "prompt": "{file:~/.config/opencode/agents/outreach-squad.md}"
    },
    "seo-squad": {
      "mode": "subagent",
      "hidden": true,
      "description": "Full SEO audits covering on-page, technical, content, and backlink analysis. Invoke when the task involves search engine optimization or audit reports.",
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "temperature": 0.3,
      "prompt": "{file:~/.config/opencode/agents/seo-squad.md}"
    },
    "content-squad": {
      "mode": "subagent",
      "hidden": true,
      "description": "Writing, editing, summarization, translation, and content strategy. Invoke for any content creation, editing, or multilingual tasks.",
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "temperature": 0.5,
      "prompt": "{file:~/.config/opencode/agents/content-squad.md}"
    },
    "reapack-prep": {
      "mode": "subagent",
      "hidden": true,
      "description": "REAPER ReaScript shipping pipeline: audit Lua, fix ReaPack headers, optimize for real-time, and build ReaPack index. Invoke via /reapack-prep command.",
      "model": "nvidia/deepseek-ai/deepseek-v4-pro",
      "temperature": 0.2,
      "prompt": "{file:~/.config/opencode/agents/reapack-prep.md}"
    },
    "code-writer": {
      "mode": "subagent",
      "hidden": true,
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "temperature": 0.3,
      "prompt": "{file:~/.config/opencode/agents/code-writer.md}"
    },
    "code-reviewer": {
      "mode": "subagent",
      "hidden": true,
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
      "temperature": 0.1,
      "prompt": "{file:~/.config/opencode/agents/code-reviewer.md}"
    },
    "bug-hunter": {
      "mode": "subagent",
      "hidden": true,
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
      "temperature": 0.1,
      "prompt": "{file:~/.config/opencode/agents/bug-hunter.md}"
    },
    "oracle": {
      "mode": "subagent",
      "hidden": true,
      "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
